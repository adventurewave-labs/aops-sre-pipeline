# A.O.P.S. Configuration — copy to .env and edit

# --- Mode ---
# 'real' = uses real K8s cluster (needs kind + setup script)
# 'sandbox' = uses mock-k8s-api (no cluster needed)
AOPS_MODE=real

# --- Ollama / LLM ---
OLLAMA_MODEL=qwen2.5:0.5b
# For better quality on GPU hosts:
# OLLAMA_MODEL=llama3.1:8b
AOPS_LLM_BACKEND=ollama
AOPS_MAX_AGENT_ROUNDS=2

# --- Popeye ---
# 'real' = try real Popeye binary, fall back to built-in
# 'builtin' = always use built-in Python analyzers
POPEYE_MODE=real

# --- Kubernetes ---
# Path to kubeconfig for docker volume mount
# After running scripts/setup-kind-cluster.sh, this is set automatically
KUBECONFIG_PATH=~/.kube/config

# --- Slack ---
# Set to a real Slack incoming webhook URL to post to real Slack
# Leave empty to use the local mock-slack receiver
REAL_SLACK_WEBHOOK_URL=

# --- Remediation ---
# Set to 1 to preview remediation commands without applying
DRY_RUN=0
