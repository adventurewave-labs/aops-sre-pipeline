# A.O.P.S. configuration — copy to .env and edit.

# --- Mode ---------------------------------------------------------------
# Where cluster state comes from. This is the most important setting here.
#   sandbox = the bundled mock-k8s-api fixtures. Every report is labelled
#             data_source=fixtures, and the executor will not mutate anything.
#   real    = a live cluster via kubeconfig. If the cluster is unreachable the
#             scan returns 503 — it never silently falls back to fixtures.
AOPS_MODE=sandbox

# --- Popeye -------------------------------------------------------------
# Which engine turns cluster state into findings. Independent of AOPS_MODE.
#   real    = prefer the upstream Popeye binary, fall back to the built-in
#             analyzers (both read the same cluster).
#   builtin = always use the 14 built-in Python analyzers.
POPEYE_MODE=builtin

# --- Kubernetes ---------------------------------------------------------
# Path to the kubeconfig mounted into the containers. For kind this MUST be
# the internal one — a host kubeconfig points at 127.0.0.1, which inside a
# container is that container. scripts/setup-kind-cluster.sh writes both.
KUBECONFIG_PATH=./.kubeconfig.internal

# --- Ollama / LLM -------------------------------------------------------
OLLAMA_MODEL=qwen2.5:0.5b
# For better quality on a GPU host:
# OLLAMA_MODEL=llama3.1:8b
AOPS_LLM_BACKEND=ollama
AOPS_MAX_AGENT_ROUNDS=2

# --- Slack --------------------------------------------------------------
# Set to a real Slack incoming webhook to post there instead of the local
# HTML card renderer.
REAL_SLACK_WEBHOOK_URL=

# --- Remediation --------------------------------------------------------
# DRY_RUN=1 previews every kubectl command without running it. This is the
# default on purpose: the executor applies real changes to a real cluster.
# Set to 0 only when you mean it. Even then, it refuses to act on a report
# whose data_source is not "live-cluster".
DRY_RUN=1
# Seconds to wait between applying fixes and re-scanning (0 in sandbox).
AOPS_SETTLE_SECONDS=5
