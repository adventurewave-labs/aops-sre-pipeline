{
  "name": "A.O.P.S. — Real PaymentAPIHighErrorRate remediation",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aops-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Alertmanager Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [220, 220],
      "webhookId": "aops-alert-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://popeye-scanner:8004/scan?namespace=payment-prod",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer aops-demo-token" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "2",
      "name": "Popeye Scan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [440, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://dify-lite:8002/v1/chat/completions",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "qwen2.5:0.5b" },
            { "name": "messages", "value": "={[\n  { role: 'system', content: 'You are AURA-SRE, a senior SRE co-pilot. Use the Popeye JSON to produce a remediation runbook with: 1) root-cause hypothesis, 2) numbered remediation steps with kubectl commands, 3) risk/blast-radius notes, 4) suggested follow-up alerts. Use Markdown.' },\n  { role: 'user', content: JSON.stringify($json) }\n]}" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "3",
      "name": "Dify Agent Reasoning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [660, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://slack-receiver:8003/webhook/slack",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "alert_name", "value": "={{$json.choices[0].message.content.match(/# A.O.P.S. Remediation Runbook/)?.[0] || 'PaymentAPIHighErrorRate'}}" },
            { "name": "namespace", "value": "payment-prod" },
            { "name": "severity", "value": "critical" },
            { "name": "score", "value": "={{$node['Popeye Scan'].json.score}}" },
            { "name": "grade", "value": "={{$node['Popeye Scan'].json.grade}}" },
            { "name": "text", "value": "={{$json.choices[0].message.content}}" },
            { "name": "trace", "value": "={{$json._dify_lite_trace}}" },
            { "name": "duration_s", "value": "={{$json._dify_lite_duration_s}}" }
          ]
        }
      },
      "id": "4",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://remediation-executor:8005/remediate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "popeye_score", "value": "={{$node['Popeye Scan'].json.score}}" },
            { "name": "runbook", "value": "={{$json.choices[0].message.content}}" }
          ]
        },
        "options": { "timeout": 300000 }
      },
      "id": "6",
      "name": "Execute Remediation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [880, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{{ status: 'remediation_posted', slack_card: $json, remediation_result: $node['Execute Remediation'].json, agent_trace: $node['Dify Agent Reasoning'].json._dify_lite_trace }}}"
      },
      "id": "5",
      "name": "Respond to Alertmanager",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1100, 300]
    }
  ],
  "connections": {
    "Alertmanager Webhook": {
      "main": [ [ { "node": "Popeye Scan", "type": "main", "index": 0 } ] ]
    },
    "Popeye Scan": {
      "main": [ [ { "node": "Dify Agent Reasoning", "type": "main", "index": 0 } ] ]
    },
    "Dify Agent Reasoning": {
      "main": [ [ { "node": "Post to Slack", "type": "main", "index": 0 }, { "node": "Execute Remediation", "type": "main", "index": 0 } ] ]
    },
    "Post to Slack": {
      "main": [ [ { "node": "Respond to Alertmanager", "type": "main", "index": 0 } ] ]
    },
    "Execute Remediation": {
      "main": [ [ { "node": "Respond to Alertmanager", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "_aops": {
      "description": "REAL A.O.P.S. pipeline: Prometheus Alertmanager -> real n8n -> Popeye (real binary) -> dify-lite + Ollama (real LLM) -> Slack -> remediation executor (real kubectl)",
      "trigger_example": "curl -X POST http://n8n:5678/webhook/aops-alert -d '{\"alertname\":\"PaymentAPIHighErrorRate\",\"severity\":\"critical\",\"namespace\":\"payment-prod\"}'"
    }
  }
}
